---
import Layout from '../layouts/Layout.astro';
import TopBar from '../components/TopBar.astro';
import { formatBuildDateJst } from '../components/buildDate';
import '../styles/title.css';
---

<Layout title="Haruworld — Engineer & Designer" variant="title">
  <TopBar />

  <section class="title">
    <div class="frame frame--rooms" aria-label="タイトル画面">
      <div class="cam" aria-hidden="true"><div class="world"><div class="hall"><i class="floor"></i><i class="ceil"></i><i class="wall wall--r"></i><i class="wall wall--l"></i><i class="wall wall--end"></i></div></div></div>
      <div class="frame__hud hud">
        <span>SCENE 00 / TITLE</span>
        <span>{formatBuildDateJst()}</span>
      </div>
      <p class="side side--l hud hud--on">Engineer &amp; Designer</p>
      <p class="side side--r hud">Haru Minemura</p>
      <div class="frame__title">
        <h1>HARUWORLD<span class="cur" aria-hidden="true"></span></h1>
      </div>
      <nav class="start" aria-label="主要ページ">
        <a href="/about/"><strong>ABOUT</strong></a>
        <a href="/projects/"><strong>PROJECTS</strong></a>
        <a href="/skills/"><strong>SKILLS</strong></a>
        <a href="/contact/"><strong>CONTACT</strong></a>
      </nav>
    </div>
  </section>
</Layout>
