---
import FontFaces from '../components/FontFaces.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  variant: 'title' | 'screen';
}
const { title, description = 'Haruworld — Engineer & Designer', variant } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <FontFaces inline={variant === 'title'} />
  </head>
  <body>
    <div class={`wrap wrap--${variant}`}><slot /></div>
  </body>
</html>
