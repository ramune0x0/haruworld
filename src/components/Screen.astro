---
import { formatBuildDateJst } from './buildDate';

interface Props {
  /** 画面左上の HUD (例: SCENE 01 / ABOUT) */
  scene: string;
  heading: string;
  /** 見出し右の HUD */
  hud: string;
  /** section の aria-label */
  label: string;
  /** 本文を縦中央に寄せる */
  center?: boolean;
  commands: [{ href: string; label: string }, { href: string; label: string }];
}
const { scene, heading, hud, label, center = false, commands } = Astro.props;
---

<section class="screen" aria-label={label}>
  <div class="frame__hud hud">
    <span>{scene}</span>
    <span>{formatBuildDateJst()}</span>
  </div>
  <div class:list={['screen__body', { 'screen__body--center': center }]}>
    <div class="section-head">
      <h2>{heading}</h2>
      <span class="hud">{hud}</span>
    </div>
    <slot />
  </div>
  <nav class="screen__cmd" aria-label="前後のページ">
    {commands.map((command) => <a href={command.href}>{command.label}</a>)}
  </nav>
</section>
