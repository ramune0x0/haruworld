---
type PageId = 'about' | 'projects' | 'skills' | 'contact';

interface Props {
  /** 省略時はロゴのみ (タイトル画面) */
  current?: PageId;
}
const { current } = Astro.props;
const items: { id: PageId; label: string }[] = [
  { id: 'about', label: 'About' },
  { id: 'projects', label: 'Projects' },
  { id: 'skills', label: 'Skills' },
  { id: 'contact', label: 'Contact' },
];
---

<header class="topbar">
  <a class="logo" href="/">HARUWORLD</a>
  {
    current && (
      <nav class="hud">
        {items.map((item) => (
          <a href={`/${item.id}/`} aria-current={item.id === current ? 'page' : undefined}>{item.label}</a>
        ))}
      </nav>
    )
  }
</header>
